    {
      "parameters": {
        "jsCode": "\nconst order = $('On form submission').first().json;\nconst products = $input.all().map(item => item.json);\n\nconst productName = String(order['Product'] ?? '').trim();\nconst quantity = Number(order['Quantity']);\n\nconst product = products.find(\n  p => String(p.Product_Name).trim() === productName\n);\n\nconst validQuantity =\n  Number.isInteger(quantity) && quantity > 0;\n\nconst stock = product ? Number(product.Stock) : 0;\nconst price = product ? Number(product.Price) : 0;\n\nconst validProductData =\n  !!product &&\n  Number.isFinite(stock) &&\n  Number.isInteger(stock) &&\n  stock >= 0 &&\n  Number.isFinite(price) &&\n  price >= 0;\n\nconst available =\n  validProductData &&\n  validQuantity &&\n  stock >= quantity;\n\nconst total = available ? price * quantity : 0;\nconst remainingStock = available ? stock - quantity : stock;\n\nreturn [{\n  json: {\n    orderId: `SC-${Date.now()}`,\n    customerName: order['Customer Name'],\n    email: order['Email Address'],\n    phone: order['Phone Number'],\n    address: order['Delivery Address'],\n    productId: product?.Product_ID ?? null,\n    productName,\n    quantity,\n    unitPrice: price,\n    total,\n    currentStock: stock,\n    remainingStock,\n    lowStockThreshold: Number(product?.Low_Stock_Threshold ?? 0),\n    stockAvailable: available,\n    status: available ? 'Pending' : 'Rejected',\n    orderDate: new Date().toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
